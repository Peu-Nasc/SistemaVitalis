{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sistemavitalis.com.br" }],
      "destination": "/landing/index.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "sistemavitalis.com.br" }],
      "destination": "/landing/$1"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.sistemavitalis.com.br" }],
      "destination": "/landing/index.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.sistemavitalis.com.br" }],
      "destination": "/landing/$1"
    },
    {
      "source": "/",
      "destination": "/app.html"
    }
  ]
}